{
  "name": "yellow-three/voyager",
  "description": "Community fork of the archived thedevdojo/voyager — Laravel 13 + Livewire 4 + Tailwind CSS 4",
  "keywords": [
    "laravel",
    "admin",
    "panel",
    "voyager",
    "livewire",
    "tailwindcss"
  ],
  "license": "MIT",
  "homepage": "https://github.com/yellow-three/voyager",
  "support": {
    "issues": "https://github.com/yellow-three/voyager/issues",
    "source": "https://github.com/yellow-three/voyager"
  },
  "authors": [
    {
      "name": "yellow-three",
      "homepage": "https://github.com/yellow-three"
    }
  ],
  "require": {
    "php": "^8.3|^8.4|^8.5",
    "illuminate/support": "^13.0",
    "livewire/livewire": "^3.0|^4.0",
    "intervention/image": "^3.0",
    "doctrine/dbal": "^3.1|^3.5|^4.0",
    "laravel/ui": ">=1.0",
    "league/flysystem": "~3.0",
    "ext-json": "*"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-livewire": "^4.0",
    "laravel/framework": "^13.0",
    "orchestra/testbench": "^11.0",
    "orchestra/testbench-browser-kit": "^11.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "YellowThree\\Voyager\\": "src/",
      "YellowThree\\VoyagerMenu\\": "plugins/menu/src/",
      "YellowThree\\VoyagerBlog\\": "plugins/blog/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "YellowThree\\Voyager\\Tests\\": "tests/",
      "YellowThree\\Voyager\\Tests\\Database\\Factories\\": "tests/database/factories/",
      "Database\\Seeders\\": "vendor/orchestra/testbench-core/laravel/database/seeders"
    }
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "YellowThree\\Voyager\\VoyagerServiceProvider",
        "YellowThree\\Voyager\\Providers\\VoyagerDummyServiceProvider",
        "YellowThree\\VoyagerMenu\\MenuServiceProvider",
        "YellowThree\\VoyagerBlog\\BlogServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
