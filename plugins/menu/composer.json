{
    "name": "yellow-three/voyager-menu",
    "description": "Voyager v3 Menu Builder Plugin — Drag-and-drop menu management",
    "keywords": ["laravel", "voyager-plugin"],
    "license": "MIT",
    "require": {
        "php": "^8.3|^8.4|^8.5",
        "yellow-three/voyager": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "YellowThree\\VoyagerMenu\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YellowThree\\VoyagerMenu\\MenuServiceProvider"
            ]
        }
    }
}
